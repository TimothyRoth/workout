#!/usr/bin/env php
<?php
/**
 * Maintenance commands (run as the web user so the SQLite files keep their owner):
 *
 *   sudo -u www-data php bin/console app:user:create <username> <password>
 *   sudo -u www-data php bin/console app:user:password <username> <password>
 *   sudo -u www-data php bin/console app:user:list
 *   sudo -u www-data php bin/console app:user:delete <username>
 *
 * WORKOUT_DB selects the database like for the web app.
 */

declare(strict_types=1);

require __DIR__ . '/../vendor/autoload.php';
require __DIR__ . '/../config.php';

use App\Database;

function fail(string $message): never
{
    fwrite(STDERR, $message . PHP_EOL);
    exit(1);
}

function usage(): never
{
    fail("Usage:\n  bin/console app:user:create <username> <password>\n  bin/console app:user:password <username> <password>\n  bin/console app:user:list\n  bin/console app:user:delete <username>");
}

function validUsername(string $username): string
{
    $username = trim($username);
    if ($username === '' || mb_strlen($username) > 180) {
        fail('Username must be 1-180 characters.');
    }
    return $username;
}

function validPassword(string $password): string
{
    if (strlen($password) < 8) {
        fail('Password must be at least 8 characters.');
    }
    return $password;
}

$command = $argv[1] ?? '';
$args = array_slice($argv, 2);

Database::connect();

switch ($command) {
    case 'app:user:create':
        [$username, $password] = $args + [null, null];
        if ($username === null || $password === null) {
            usage();
        }
        $username = validUsername($username);
        if (Database::findUserByUsername($username) !== null) {
            fail("User '$username' already exists.");
        }
        Database::createUser($username, password_hash(validPassword($password), PASSWORD_DEFAULT));
        echo "User '$username' created successfully.", PHP_EOL;
        break;

    case 'app:user:password':
        [$username, $password] = $args + [null, null];
        if ($username === null || $password === null) {
            usage();
        }
        $user = Database::findUserByUsername(validUsername($username)) ?? fail("User '$username' not found.");
        Database::updateUserPassword((int)$user['id'], password_hash(validPassword($password), PASSWORD_DEFAULT));
        echo "Password of '{$user['username']}' changed; remembered logins were revoked.", PHP_EOL;
        break;

    case 'app:user:list':
        $users = Database::getUsers();
        if ($users === []) {
            echo "No users yet. Create one with app:user:create.", PHP_EOL;
        }
        foreach ($users as $user) {
            printf("%-4d %-30s %s\n", $user['id'], $user['username'], $user['created_at']);
        }
        break;

    case 'app:user:delete':
        $username = $args[0] ?? usage();
        $user = Database::findUserByUsername(validUsername($username)) ?? fail("User '$username' not found.");
        Database::deleteUser((int)$user['id']);
        echo "User '{$user['username']}' deleted.", PHP_EOL;
        break;

    default:
        usage();
}
